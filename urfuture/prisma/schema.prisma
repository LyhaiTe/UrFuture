generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  COUNSELOR
  ADMIN
}

enum EducationLevel {
  HS_JUNIOR
  HS_SENIOR
  UNIVERSITY_YEAR_1
  UNIVERSITY_YEAR_2
  UNIVERSITY_YEAR_3
  UNIVERSITY_YEAR_4
  GRADUATE
}

enum TranscriptStatus {
  UPLOADED
  PARSING
  PARSED
  FAILED
}

enum PathwayStepType {
  CURRENT_STATE
  MAJOR
  COURSE_MILESTONE
  CERTIFICATION
  INTERNSHIP
  CAREER_ENTRY
}

enum StudyPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  role UserRole @default(STUDENT)
  educationLevel EducationLevel?
  institution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transcripts Transcript[]
  skills UserSkill[]
  conversations Conversation[]
  careerPaths CareerRecommendation[]
  studyPlans StudyPlan[]
  quizAttempts QuizAttempt[]
  jobFitChecks JobFitCheck[]
  counselorReviews CounselorReview[] @relation("ReviewedStudent")
  reviewsAuthored CounselorReview[] @relation("ReviewingCounselor")
  @@index([email])
}

model Transcript {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName String
  fileUrl String
  yearLabel String?
  status TranscriptStatus @default(UPLOADED)
  rawText String? @db.Text
  parsedCourses Json?
  gpa Float?
  uploadedAt DateTime @default(now())
  parsedAt DateTime?
  @@index([userId])
}

model Skill {
  id String @id @default(cuid())
  name String @unique
  category String?
  onetElementId String?
  userSkills UserSkill[]
  careerSkillReqs CareerSkillRequirement[]
  quizQuestions QuizQuestion[]
}

model UserSkill {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill Skill @relation(fields: [skillId], references: [id])
  proficiency Float
  source String
  lastUpdated DateTime @updatedAt
  @@unique([userId, skillId, source])
  @@index([userId])
}

model CareerPath {
  id String @id @default(cuid())
  title String @unique
  onetSocCode String?
  descriptionShort String
  medianSalaryUsd Float?
  growthOutlook String?
  sourceNote String @db.Text
  requiredEducation EducationLevel?
  skillRequirements CareerSkillRequirement[]
  recommendations CareerRecommendation[]
  pathwaySteps PathwayStep[]
}

model CareerSkillRequirement {
  id String @id @default(cuid())
  careerPathId String
  careerPath CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  skillId String
  skill Skill @relation(fields: [skillId], references: [id])
  importance Float
  @@unique([careerPathId, skillId])
}

model PathwayStep {
  id String @id @default(cuid())
  careerPathId String
  careerPath CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  type PathwayStepType
  label String
  order Int
  metadata Json?
}

model CareerRecommendation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerPathId String
  careerPath CareerPath @relation(fields: [careerPathId], references: [id])
  fitScore Float
  matchedSkills Json
  missingSkills Json
  rationale String @db.Text
  citations Json
  requiresReview Boolean @default(false)
  createdAt DateTime @default(now())
  counselorReview CounselorReview?
}

model StudyPlan {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  targetSkillIds Json
  weeks Json
  status StudyPlanStatus @default(DRAFT)
  citations Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizQuestion {
  id String @id @default(cuid())
  skillId String
  skill Skill @relation(fields: [skillId], references: [id])
  prompt String @db.Text
  choices Json
  correctIndex Int
  difficulty String
  sourceCourse String?
  answers QuizAnswer[]
}

model QuizAttempt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  basedOnTranscriptIds Json
  scorePercent Float?
  startedAt DateTime @default(now())
  completedAt DateTime?
  answers QuizAnswer[]
}

model QuizAnswer {
  id String @id @default(cuid())
  quizAttemptId String
  quizAttempt QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  questionId String
  question QuizQuestion @relation(fields: [questionId], references: [id])
  selectedIndex Int
  isCorrect Boolean
  @@index([quizAttemptId])
}

model JobFitCheck {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle String
  jobDescriptionRaw String @db.Text
  extractedSkills Json
  matchedCount Int
  totalRequired Int
  fitScorePercent Float
  gapClosingPlanId String?
  createdAt DateTime @default(now())
}

model CounselorReview {
  id String @id @default(cuid())
  studentId String
  student User @relation("ReviewedStudent", fields: [studentId], references: [id], onDelete: Cascade)
  counselorId String?
  counselor User? @relation("ReviewingCounselor", fields: [counselorId], references: [id])
  careerRecommendationId String? @unique
  careerRecommendation CareerRecommendation? @relation(fields: [careerRecommendationId], references: [id])
  reason String
  status ReviewStatus @default(PENDING)
  counselorNotes String? @db.Text
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([studentId])
  @@index([status])
}

model Conversation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String?
  createdAt DateTime @default(now())
  messages Message[]
}

model Message {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role MessageRole
  content String @db.Text
  toolCalls Json?
  citations Json?
  createdAt DateTime @default(now())
  @@index([conversationId])
}