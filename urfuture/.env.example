# --- LLM API (Groq) ---
GROQ_API_KEY="gsk_..."
LLM_MODEL="openai/gpt-oss-20b"

# --- Database ---
# Local Postgres with pgvector extension (via Docker Compose / RDS)
DATABASE_URL="postgresql://advisor:advisor@localhost:5433/urfuture?schema=public"

# --- Vector Database & RAG (src/lib/rag.ts, scripts/ingest-knowledge.ts) ---
# "openai" | "voyage" (default/active) | "local" (dev fallback)
EMBEDDING_PROVIDER="voyage"
VOYAGE_API_KEY="pa-..."
VOYAGE_MODEL="voyage-large-2"
EMBEDDING_MODEL="text-embedding-3-small"

# Vector Search Tuning
RAG_SIMILARITY_THRESHOLD="0.72"
RAG_TOP_K="5"

# Optional: OpenAI as an alternate embedding provider
OPENAI_API_KEY="sk-..."

# Optional: Pinecone vector DB fallback
PINECONE_API_KEY=
PINECONE_INDEX=cambodia-advisor-kb

# O*NET Web Services v2 (request an API key from services.onetcenter.org)
ONET_API_KEY=
ONET_USERNAME=sn6024010087@camtech.edu.kh
ONET_PASSWORD=

# --- Google OAuth 2.0 & Session Auth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/student/google/callback"
AUTH_SESSION_SECRET=generate-a-long-random-secret