# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# --- Database ---
# Local Postgres, e.g. via `docker compose up -d`
DATABASE_URL="postgresql://advisor:advisor@localhost:5433/cambodia_advisor?schema=public"

# --- RAG / knowledge sources (optional, prototype falls back to seeded mock data) ---
# Pinecone (or swap for pgvector - see README "Swapping in real RAG")
PINECONE_API_KEY=
PINECONE_INDEX=cambodia-advisor-kb

# O*NET Web Services (skills/knowledge taxonomy reference only)
ONET_USERNAME=
ONET_PASSWORD=

# ILOSTAT / NEA Cambodia — no stable public API confirmed at build time.
# Prototype ships with seeded snapshots in prisma/seed.ts instead.

#Google OAuth 2.0 Client ID and Secret for student login
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/student/google/callback"
AUTH_SESSION_SECRET=generate-a-long-random-secret

#AWS RDS PostgreSQL connection
DATABASE_URL="postgresql://DB_USER:URL_ENCODED_DB_PASSWORD@RDS_ENDPOINT:5432/DB_NAME?schema=public&sslmode=require"